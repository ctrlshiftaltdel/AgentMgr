# Local orchestration archive (retired offline kit; machine-local)
.orchestration/
# Python caches from local helper scripts
__pycache__/
*.py[cod]
# Per-task worktrees (Agent execution workspaces)
.worktrees/
.venv/
# Local-only machine/environment info (never commit)
local_info.md
# Credentials (never commit; owner-provided real keys live in .env)
.env
.env.*
!.env.example
