# Example environment file for the WeChat B1 Bridge.
#
# Copy to a root-only location (mode 0600), replace every <placeholder>, and
# keep it out of the repository. systemd reads EnvironmentFile as PID 1, so the
# bridge user does not need read access to this file.
#
# Never put the WeChat token, QR content or context_token here: the token lives
# only in the SDK credential file.

# Database used by Task Intake. Use the pilot/test database, never production.
AJAIMGR_DB_URL=postgresql+psycopg://<db-user>:<db-password>@<db-host>/<db-name>
AJAIMGR_ENV=pilot

# Root-only SDK credential file (absolute path). It must be mode 0600/0400 and
# must not be group/other readable.
AJAIMGR_WECHAT_CREDENTIAL_PATH=/var/lib/ajaimgr-wechat/credentials.json
# Company that channel bindings must resolve to. Required.
AJAIMGR_WECHAT_COMPANY_ID=<company-id>
# Read-only command prefix; B1 only serves /help and /whoami.
AJAIMGR_WECHAT_COMMAND_PREFIX=/

# Salt for channel identity hashes in rejection/acceptance audit. Required for
# non-guessable hashes; the bridge does not log identity plaintext either way.
AJAIMGR_IDENTITY_HASH_SALT=<random-salt>
# Existing internal token source used as the hash salt fallback only. Provide a
# strong random value; do not reuse a personal or shared credential.
AJAIMGR_INTERNAL_TOKEN=<random-internal-token>
