[Unit]
Description=AgentMgr policy enforcement point gateway (managed execution)
Documentation=file:///usr/local/share/doc/agentmgr/security/README.md
After=network.target
Before=agentmgr-task@*.service

[Service]
Type=simple
User=<controller-user>
Group=<controller-group>
WorkingDirectory=<install-root>
RuntimeDirectory=agentmgr-exec
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 -m app.security.gateway --socket /run/agentmgr-exec/gateway.sock
Restart=on-failure
RestartSec=2

# The gateway owns the Unix socket and the revocation store under
# /run/agentmgr-exec.  It never needs a writable system path or a home.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
